# ============================================
# Dar Zitoun Restaurant - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# ============================================

# --------------------------------------------
# REQUIRED - Application
# --------------------------------------------
# Production site URL (must be HTTPS in production)
# Example: https://darzitoun.tn
SITE_URL=https://your-domain.tn

# Secret for first-admin bootstrap (min 32 characters)
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=your-super-secret-bootstrap-key-here-min-32-chars

# Secret for automated cron tasks (min 32 characters)
# Required for /api/cron/anonymize and /api/cron/reminders
# Generate with: openssl rand -hex 32
CRON_SECRET=your-super-secret-cron-key-here-min-32-chars

# --------------------------------------------
# REQUIRED - Database (PostgreSQL)
# --------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/darzitoun

# Or individual PostgreSQL parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=darzitoun

# --------------------------------------------
# OPTIONAL - Security Features
# --------------------------------------------
# Force secure cookies in development (for HTTPS localhost with mkcert)
# Set to "true" if using HTTPS in development
FORCE_SECURE_COOKIES=false

# Force HSTS header in development
# Set to "true" to enable HSTS in development
FORCE_HSTS=false

# --------------------------------------------
# OPTIONAL - Rate Limiting (Redis)
# --------------------------------------------
# Upstash Redis REST API (for production rate limiting)
# Get from: https://upstash.com/
# Leave empty to use in-memory rate limiting (development only)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# --------------------------------------------
# OPTIONAL - Email (for notifications)
# --------------------------------------------
# SMTP configuration for reservation confirmations, etc.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@your-domain.tn

# --------------------------------------------
# OPTIONAL - External Services
# --------------------------------------------
# Google Maps API key (for maps integration)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# WhatsApp Business API (for order notifications)
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0/your-phone-id/messages
# WHATSAPP_API_TOKEN=your-whatsapp-token

# --------------------------------------------
# OPTIONAL - Monitoring & Analytics
# --------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Vercel Analytics (auto-enabled on Vercel)
# VERCEL_ANALYTICS_ID=your-analytics-id

# --------------------------------------------
# DEVELOPMENT ONLY
# --------------------------------------------
# Set to "development", "production", or "test"
NODE_ENV=development