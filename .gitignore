# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright-cli/

# Next.js Build Output
/.next/
/out/
/build

# OS & Temp files
.DS_Store
Thumbs.db
*.tmp
*.bak
/*.png

# Certificates & Private Keys
*.pem
*.key
*.crt
*.cert
cert.pem
key.pem

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.log*
dev.log

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Local SQLite Databases & Data Directory
/data/
*.sqlite*
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# User Uploaded Files (preserve directory with .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# AI Agent Skills, Prompt Blueprints & Internal Prompts (KEEP PRIVATE)
/.agents/
/.claude/
*.skill
skills-lock.json
AGENTS.md
SKILL*.md
"SKILL*.md"

# Internal Audit, Design & QA Reports (KEEP PRIVATE)
*REPORT.md
*_REPORT.md
ADMIN_QA_REPORT.md
BUTTON_SYSTEM_REPORT.md
RESERVATION_QA_REPORT.md
PROJECT_AUDIT.md
CREATIVE_DIRECTION.md
DESIGN.md
animation.md
libraries.md
/design-system/
/docs/

# Local Agent & Tool Cache / State (Tokens, browser sessions)
/.superpowers/
.claude/
.claude/settings.local.json
.claude/*.local.json
.claude/state/

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Vercel Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
